{
	"name": "devradar",
	"version": "0.1.0",
	"description": "Follow selected GitHub users and record public activity in connected Markdown notes.",
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"packageManager": "npm@10.9.2",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"check": "npm run format:check && npm run lint && npm run test && npm run build",
		"prepare": "husky",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"version:sync": "node version-bump.mjs sync",
		"version:check": "node version-bump.mjs check",
		"lint": "eslint ."
	},
	"lint-staged": {
		"**/*.{ts,js,mjs,cjs,mts}": [
			"prettier --write",
			"eslint --fix"
		],
		"**/*.{md,json,yml,yaml,css}": [
			"prettier --write"
		]
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.1",
		"esbuild": "0.28.1",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.9.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"lint-staged": "^16.4.0",
		"obsidian": "1.13.1",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vitest": "^4.1.10",
		"yaml": "^2.9.0"
	}
}
