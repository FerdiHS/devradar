{
	"name": "devradar",
	"version": "0.0.1",
	"description": "Follow selected GitHub users and record public activity in connected Markdown notes.",
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"check": "npm run format:check && npm run lint && npm run test && npm run build",
		"prepare": "husky",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"lint-staged": {
		"**/*.{ts,js,mjs,cjs,mts}": [
			"prettier --write",
			"eslint --fix"
		],
		"**/*.{md,json,yml,yaml,css}": [
			"prettier --write"
		]
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"lint-staged": "^16.4.0",
		"obsidian": "latest",
		"prettier": "^3.9.6",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10"
	}
}
